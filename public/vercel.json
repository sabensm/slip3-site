{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "slip3-site.vercel.app" }], "destination": "https://slip3studios.com/$1", "permanent": true},
    { "source": "/contact", "destination": "/about/", "permanent": true},
    { "source": "/contact/", "destination": "/about/", "permanent": true}
  ],
  "headers": [
    {"source": "/img/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/fonts/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/media/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}]}
  ]
}
